# Copy this file to .env and fill in your own values.
# Never commit the real .env file: it contains your database password.

# MongoDB connection string
#   MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app-name>
#   Local MongoDB: mongodb://127.0.0.1:27017
MONGODB_URI=

# Optional: the port the API listens on (defaults to 3000)
# PORT=3000
